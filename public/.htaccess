# Redirecionamento para HTTPS e domínio canônico marmorarias.shop
DirectoryIndex index.html

RewriteEngine On

# Forçar HTTPS + não-www em um único redirecionamento canônico
RewriteCond %{HTTPS} off [OR]
RewriteCond %{HTTP_HOST} ^www\.marmorarias\.shop$ [NC]
RewriteRule ^(.*)$ https://marmorarias.shop/$1 [L,R=301]

# 1) Servir HTML SSG sem redirecionar para barra final
#    Ex.: /granito -> /granito.html ; /blog/artigo -> /blog/artigo.html
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{DOCUMENT_ROOT}/$1.html -f
RewriteRule ^(.+?)/?$ /$1.html [L]

# 2) Compatibilidade: servir index.html pré-renderizado por rota quando existir
RewriteCond %{DOCUMENT_ROOT}/$1/index.html -f
RewriteRule ^(.+?)/?$ /$1/index.html [L]

# 3) SPA fallback (apenas se não houver HTML pré-renderizado)
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteRule ^ index.html [L]

# Compressão
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css text/javascript application/javascript application/json image/svg+xml
</IfModule>

# Cache de assets estáticos
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType image/jpg "access plus 1 year"
  ExpiresByType image/jpeg "access plus 1 year"
  ExpiresByType image/png "access plus 1 year"
  ExpiresByType image/webp "access plus 1 year"
  ExpiresByType image/svg+xml "access plus 1 year"
  ExpiresByType text/css "access plus 1 month"
  ExpiresByType application/javascript "access plus 1 month"
  ExpiresByType font/woff2 "access plus 1 year"
</IfModule>

# Headers de segurança
<IfModule mod_headers.c>
  Header set X-Content-Type-Options "nosniff"
  Header set X-Frame-Options "SAMEORIGIN"
  Header set Referrer-Policy "strict-origin-when-cross-origin"
  Header set X-Robots-Tag "index, follow"
</IfModule>
